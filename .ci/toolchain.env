# Single source of truth for toolchain pins (Local DX + GitHub Actions).
# Sourced by scripts/ci/_lib.sh. Workflows load via scripts/ci/export_toolchain.sh.
#
# Bump versions here only — do not hardcode elsewhere.

FLUTTER_VERSION=3.38.9
NODE_VERSION=22.17.0
NPM_VERSION=10.9.2

# Informational (doctor / docs). Not enforced as a separate SDK install.
# Dart ships with the Flutter SDK above.
DART_SDK_HINT=3.10.x
