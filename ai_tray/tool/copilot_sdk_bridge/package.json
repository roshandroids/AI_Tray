{
  "name": "ai-tray-copilot-sdk-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Persistent, versioned GitHub Copilot SDK bridge for AI Tray.",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "verify:dependencies": "node -e \"require('koffi'); import('@github/copilot-sdk').then(() => process.stdout.write('Pinned SDK dependencies loaded successfully.\\n'))\"",
    "prebuild": "npm run verify:dependencies",
    "build": "tsc --project tsconfig.json",
    "check": "npm run build && node --test dist/test/*.test.js",
    "distribution:assemble": "node scripts/assemble_sidecar.mjs",
    "distribution:smoke": "node scripts/smoke_protocol.mjs",
    "distribution:verify": "node scripts/verify_payload.mjs",
    "poc": "npm run build && node dist/src/cli.js",
    "start": "node dist/src/bridge_cli.js",
    "test:integration": "npm run build && COPILOT_SDK_INTEGRATION=1 node --test dist/test/authenticated.integration.test.js"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.7"
  },
  "devDependencies": {
    "@types/node": "24.0.15",
    "typescript": "5.8.3"
  },
  "allowScripts": {
    "koffi@3.1.1": true
  }
}
