<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox intentionally off (was on): AI Tray's core purpose is
	     running an arbitrary CLI (`claude --resume ...`) against arbitrary
	     user project directories chosen at runtime, and reading the real
	     ~/.claude/projects tree — App Sandbox virtualizes $HOME to the app's
	     own container for both the app and any spawned child process, which
	     made the Session Browser (and every `claude` invocation) blind to
	     the real user data regardless of the temporary-exception entitlements
	     below (those only grant access relative to the true home directory;
	     the code never reached it because $HOME itself was redirected).
	     Distribution is via signed/notarized GitHub releases, not the Mac
	     App Store, so sandboxing was providing no real requirement here. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
